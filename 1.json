{
    "인공어": {
        "어근": [
            "din : -에 대항하여, -에 반대되는",
            "cav : -을 향해 이동, -의 형태로 변화",
            "yer : 서로",
            "cir : 함께, 여럿 있음",
            "nir : 혼자, 하나 있음",
            "vri : 앞/먼저, 위, 긍정",
            "dav : 뒤/나중에, 아래, 부정",
            "nan : 내부, 알다",
            "nis : 외부, 모르다",
            "-ne : -하게 만들다",
            "-ti : -당하다",
            "da : 사람"
        ]
    },
    "문법": {
        "1": "재귀는 금지되며 문장은 단문으로만 구성됨",
        "2": "어순은 '주어 서술어 목적어 보어' 순",
        "예문": {
            "1": "nirda cavvrine yercirneda",
            "2": "nirda decirne dinnisda"
        }
    }
