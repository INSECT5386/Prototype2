{
    "규칙": {
        "1": "어근 단독 사용 불가 및 무조건 머리-꼬리로 구성되며 이는 1차 복합어임",
        "2": "1차 복합어는 교착적 결합 불가. 단 전치수식 구 형태 2차 복합어 생성"
    },
    "1": {
        "머리": [
            "gan : 긍정, 존재",
            "neg : 부정, 부재",
            "an : 앎, 지식",
            "tun : 생각, 논리",
            "git : 변화, 이동",
            "iot : 사용"
        ]
    },
    "2": {
        "꼬리": [
            "lo : 스스로 - 하다",
            "ri : - 하게 만들다",
            "ne : - 당하다"
        ]
    },
    "3": {
        "1차 복합어": [
            "ganlo : 살다, 존재하다, 생존하다",
            "ganri :살리다, 존재하게 하다, 창조하다, 만들다",
            "ganne : 만들어지다, 태어나다, 창조물, 피조물",
            "neglo : 죽다, 없어지다, 사라지다",
            "negri : 없애다, 죽이다, 지우다",
            "negne : 죽임당하다, 부숴지다, 파손품",
            "anlo : 알다, 깨닫다, 이해하다",
            "anri : 가르치다, 알리다, 전수하다",
            "anne : 알려지다, 이해되다, 지식/정보",
            "tunlo : 생각하다, 고민하다, 추론하다",
            "tunri : 설득하다",
            "tunne : 상각되다, 여겨지다, 사상/아이디어",
            "gitlo : 변하다, 이동하다, 움직이다",
            "gitri : 바꾸다, 옮기다, 변형시키다",
            "gitne : 바뀌다, 옮겨지다, 변형물",
            "iotlo : 사용되다, 작용하다, 쓰이다",
            "iotri : 사용하다, 이용하다, 다루다",
            "iotne : 소비당하다, 활용되다, 도구/수단"
        ]
    }
}
