{
    "인공어": {
        "문법": {
            "격틀": "1 2 3 4 : 1은 2(의 형태로/을 향해) 3하다 4(에 의해/때문에)",
            "예문": {
                "conce so tonsi ni": "그것은 장소로 이동하게 만든다"
            }
        },
        "어근": [
            "si : -하게 만들다",
            "con : 존재",
            "pon : 부재",
            "ton : 이동",
            "so : 장소",
            "ce : 물질",
            "pi : 정보",
            "ci : 지능",
            "ni : 나인 것",
            "ne : 내가 아닌 것"
        ]
    }
}
