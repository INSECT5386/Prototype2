{
    "최소주의 인공어": {
        "어근": [
            "sen : 가함/운동",
            "not : 열/비효율/약화, 반대",
            "cet : 구멍 있음/개방, 관측/결정",
            "tos : 같음/선형",
            "con : 섞임/합침, 상태/정보",
            "tet : 무게/물질/에너지"
        ],
        "규칙": {
            "A tu B": "A가 B(을 향해/의 형태로) 변화/운동",
            "1": "목적어 없고, 전치수식 사용 및 어근간 결합 금지",
            "2": "모든 개념은 어근의 조합으로 표현",
            "예문": [
                "sen tet tu. : 가해지는 물질은 (공백) 이동함",
                "con tet con tu tos not, not. : 섞인 물질의 상태는 같지 않은 것의 형태로 변화하고, 열 남"
            ]
        }
    }
}
