{
    "최소주의 인공어": {
        "어근": [
            "sen : 힘이 가해짐/운동함",
            "not : (열을 냄/비효율, 죽어감/약함), 반의어",
            "cet : (구멍 있음/개방된), (관측/결정된)",
            "tos : (같음/선형)",
            "con : 섞인/합침, (상태/정보)",
            "tet : 무게/물질, 에너지"
        ],
        "규칙": {
            "A tu B": "A(주어) B(을 향하여/의 형태로) 변화하다/운동하다",
            "1": "목적어는 존재하지 않는다",
            "2": "전치수식을 사용하며 어근끼리 직접 결합을 금지한다",
            "3": "모든 개념은 어근의 조합으로 표현한다",
            "예문": [
                "sen tet tu. : 힘이 가해지는 물질은 (공백) 이동함",
                "con tet con tu tos not, not. : 섞인 물질의 상태는 다양성 없는 것이 아닌 것의 형태로 변화하고, 열이 발생함"
            ]
        }
    }
}
